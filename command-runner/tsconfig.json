{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["viewer/server.ts", "viewer/scheduler.ts", "viewer/lib/**/*.ts"],
  "exclude": ["node_modules", "viewer/src/**/*", "viewer/dist/**/*"]
}
